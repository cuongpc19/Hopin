# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Android packaging. The whole android/ project is GENERATED — `npx cap add android`
# recreates it and `node scripts/setup-android.mjs` re-applies our icons + portrait
# lock — so none of it is tracked. Rebuild an APK with: npm run apk (features.txt §27)
android/
*.apk
*.aab

# Generated level previews (regenerated by scripts/build-levels.mjs)
scripts/_level-preview/

# Level-generation source clip-art — used locally by build-levels.mjs only, not
# loaded by the game at runtime. Kept out of the repo (size + third-party art).
public/art/level art/

# Archived / no-longer-used source art (slice sources + old sheets). Kept locally
# so it can be restored if needed, but out of the repo.
public/art/Notused/

# Pre-resaturation copy of the board tiles (scripts/resat-tiles.mjs APPLY=1). Local
# convenience only — git history is the real source for the originals.
art-orig/

# Scratch previews from the tile-colour work (resat-tiles.mjs and friends).
scripts/_tiles-resat/
scripts/_*.png

# Local scratch/junk folder — not part of the game or build.
/Manythings/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment / secrets
.env
.env.*
!.env.example
playlog.jsonl
scripts/_*.txt
public/art/tmp/

# Goi nop CrazyGames — dung lai tu dist/ bat cu luc nao, khong can theo doi
hopin-crazygames.zip

# Video preview (dung lai tu ban quay man hinh bat cu luc nao)
store/crazygames/*.mp4

# Firebase CLI deploy cache
.firebase/

# Anh Gemini goc de cat ra anh bia — 24MB, chi la nguyen lieu.
# Ba tam bia thanh pham trong store/crazygames/ VAN duoc theo doi.
public/art/newbackground/
