# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Generated level previews (regenerated by scripts/build-levels.mjs)
scripts/_level-preview/

# Level-generation source clip-art — used locally by build-levels.mjs only, not
# loaded by the game at runtime. Kept out of the repo (size + third-party art).
public/art/level art/

# Archived / no-longer-used source art (slice sources + old sheets). Kept locally
# so it can be restored if needed, but out of the repo.
public/art/Notused/

# Local scratch/junk folder — not part of the game or build.
/Manythings/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment / secrets
.env
.env.*
!.env.example
playlog.jsonl
scripts/_*.txt
public/art/tmp/
