{
  "name": "hop-in",
  "version": "0.1.0",
  "description": "Hop In! - conveyor color-shooter puzzle game (Phaser 3 + TS + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/optimize-art.mjs",
    "preview": "vite preview",
    "apk": "node scripts/build-apk.mjs",
    "deploy": "npm run build && gh-pages -d dist -f"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "gh-pages": "^6.3.0",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
